{
  "manifest_version": 3,
  "name": "Browser History Topic Graph",
  "version": "1.0",
  "description": "Visualize your browser history as a topic-based graph",
  "permissions": [
    "history",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "action": {
    "default_title": "Open History Graph"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_origin_rules",
        "enabled": true,
        "path": "rules_ollama.json"
      }
    ]
  }
}
