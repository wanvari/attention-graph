{
  "manifest_version": 3,
  "name": "Cognitive Trails",
  "version": "5.1.1",
  "description": "A local browsing record: find visited pages, revisit suggested topic trails, and keep optional notes.",
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "history",
    "declarativeNetRequest",
    "alarms",
    "offscreen",
    "idle",
    "search",
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/text.js",
        "lib/privacy.js",
        "content/capture.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "ui/newtab.html"
  },
  "action": {
    "default_title": "Open Cognitive Trails"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434"
  }
}
